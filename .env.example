# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPEN-SOURCE GEMMA CONFIGURATION (Hacktoberfest 2026 Touch Grass Edition)
# Optional: Set these to connect a live Google Gemma open-weight inference model.
# Works with Hugging Face Inference API, Ollama (local), vLLM, or any OpenAI-compatible Gemma proxy.
# If unset or unreachable, Nature Quotes AI automatically uses verified offline curated archives.
GEMMA_API_ENDPOINT="https://api-inference.huggingface.co/models/google/gemma-2-9b-it"
GEMMA_API_KEY=""
GEMMA_MODEL_NAME="google/gemma-2-9b-it"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

