# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPEN-SOURCE GEMMA CONFIGURATION (Hacktoberfest 2026 Touch Grass Edition)
# HF_TOKEN: Hugging Face User Access Token (read permissions) to connect Google Gemma models.
# AI Studio automatically injects this from the user's secrets panel.
HF_TOKEN="hf_your_hugging_face_token"
GEMMA_MODEL_NAME="google/gemma-3-4b-it"

# Optional: Custom self-hosted Gemma inference endpoint (e.g. Ollama http://localhost:11434/api/generate or vLLM)
GEMMA_API_ENDPOINT=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

