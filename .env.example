# GEMINI_API_KEY: Required for Google GenAI API calls (powers Google-hosted Gemma and Gemini).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE-HOSTED GEMMA CONFIGURATION (Hacktoberfest 2026 Touch Grass Edition)
# Connects directly to Google's official open-weight Gemma models on Google infrastructure.
# Default supported model: gemma-4-26b-a4b-it
GEMMA_MODEL_NAME="gemma-4-26b-a4b-it"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

